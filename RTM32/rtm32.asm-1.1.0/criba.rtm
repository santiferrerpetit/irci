/* Algoritmo de la Críba de Erastótenes:
        La Criba de Erastótenes es un algoritmo para encontrar todos los
   números primos hasta un límite N partiendo de una secuencia de números
   desde 2 hasta N (inclusive.)

        El método consiste en tomar el primer número disponible como primo
   e inmediatamente descartar ("tachar") todos sus múltiplos sucesivos.  De
   este modo, todo número no tachado que visitemos debe ser un primo dentro
   del rango.  */

.section ".data"
	n: .word 100

	// Se inicializa con ceros, entonces si hay un 1 lo tomamos como tachado.
	// En este algoritmo, es muchísimo más conveniente tener un array indexado en
	// 1 para reducir la complejidad del código.  Por eso mismo reservamos un
	// espacio de N + 1 bytes.
	tachados: .pad 1 100

.section ".text"
	addi $sp, $zero, 0xFFC

	// En $s0 guardamos el número que estamos testeando ahora mismo
	// En $s1 guardamos true (1)
	// En $s2 guardamos N
	xor $s0, $s0, $s0
	addi $s1, $zero, 1
	lw $s2, n($zero)

	// La Criba funciona en el rango [2, N], para ser completos tachamos a cero
	// y uno porque no son primos
	sb $s1, tachados($s0)
	addi $s0, $s0, 1
	sb $s1, tachados($s0)

criba_loop:
	addi $s0, $s0, 1

	// $s0 > N -> break
	bge $s0, $s2, halt

	// tachado[$s0] == true -> continue
	lbu $t0, tachados($s0)
	beq $t0, $s1, criba_loop

	/* $s0 es primo */
	
	// Lo imprimimos, para ello copiamos $s0 a $a0 para ser argumento de print32u
	addi $a0, $s0, 0
	jal print32u

	// Tachamos múltiplos, comenzamos por 2 * $s0
	add $t0, $s0, $s0

criba_tachar:
	// $t0 > N -> todos los multiplos tachados, buscar siguiente primo
	bge $t0, $s2, criba_loop

	sb $s1, tachados($t0)

	add $t0, $t0, $s0
	j criba_tachar

// equivalente a "while (true) {}", el procesador jamás escapará de esta instrucción
halt: trap 1

// Toma por $a0 una palabra no negativa y la imprime en la consola.
// Hay varias formas de implementar esta función con distintos niveles de
// complejidad.  Esta implementación empuja al stack los digitos desde el menos
// significativo hasta el más significativo y los imprime mientras los desapila
print32u:
	addi $sp, $sp, -8
	sw $s0, 0($sp)
	sw $s1, 4($sp)

	// $s0 <- $a0
	// $s1: dígitos encontrados
	addi $s0, $a0, 0
	xor $s1, $s1, $s1

	addi $t0, $zero, 10
	addi $t2, $zero, -0x100 // dirección de la consola

	// déficit de esta estrategia:  si $a0 == 0, se debe imprimir manualmente
	bne $a0, $zero, print32u'apilar

	addi $t1, $zero, '0'
	sb $t1, 0($t2)
	j print32u'salir

print32u'apilar:
	beq $s0, $zero, print32u'desapilar
	// sino, hay otro digito
	
	addi $s1, $s1, 1

	// $t1 guarda el digito actual
	restu $t1, $s0, $t0

	// quitarlo de $s0
	sub $s0, $s0, $t1
	divu $s0, $s0, $t0

	// pushearlo
	addi $t1, $t1, '0' // pasarlo a ASCII
	addi $sp, $sp, -1
	sb $t1, 0($sp)

	j print32u'apilar

print32u'desapilar:
	// no hay nada más que imprmir -> salir
	beq $s1, $zero, print32u'salir

	// imprimir el caracter
	lbu $t1, 0($sp)
	sb $t1, 0($t2)

	// quitarlo de la pila
	addi $s1, $s1, -1
	addi $sp, $sp, 1

	j print32u'desapilar

print32u'salir:
	// imprimimos un espacio despues de cada número
	addi $t1, $zero, ' '
	sb $t1, 0($t2)

	lw $s0, 0($sp)
	lw $s1, 4($sp)
	addi $sp, $sp, 8
	jr $ra, 0
